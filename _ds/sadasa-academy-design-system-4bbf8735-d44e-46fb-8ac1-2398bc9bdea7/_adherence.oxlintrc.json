{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "slides/**",
              "ui_kits/stationery/**",
              "ui_kits/video_learning/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Montserrat|IBM Plex Mono|Gotham Narrow|Galano Grotesque))/i]",
        "message": "Font not provided by the design system. Available: Montserrat, IBM Plex Mono, Gotham Narrow, Galano Grotesque."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccentRing'] > JSXAttribute > JSXIdentifier[name!=/^(?:strength|size|position|rotate|assetBase|key|ref|className|style|children)$/]",
        "message": "<AccentRing> doesn't accept that prop. Declared props: strength, size, position, rotate, assetBase."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccentRing'] > JSXAttribute[name.name='strength'] > Literal[value!=/^(?:faint|default|strong)$/]",
        "message": "<AccentRing> strength must be one of 'faint' | 'default' | 'strong'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccentRing'] > JSXAttribute[name.name='position'] > Literal[value!=/^(?:bottom-right|bottom-left|top-right|top-left|right|center)$/]",
        "message": "<AccentRing> position must be one of 'bottom-right' | 'bottom-left' | 'top-right' | 'top-left' | 'right' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccentRule'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|thickness|tone|align|key|ref|className|style|children)$/]",
        "message": "<AccentRule> doesn't accept that prop. Declared props: width, thickness, tone, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccentRule'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:red|gold|ink|hairline)$/]",
        "message": "<AccentRule> tone must be one of 'red' | 'gold' | 'ink' | 'hairline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccentRule'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<AccentRule> align must be one of 'left' | 'center' | 'right'."
