# =====================================================================
# Peta Desa Nusantara — IDM 2023–2024
#
# .github/workflows/deploy.yml meng-upload SELURUH repo (path: '.') ke
# GitHub Pages. Artinya:
#   - berkas yang di-ignore TIDAK ikut live -> fetch() di index.html 404
#   - berkas > 100 MB menggagalkan push; situs Pages maksimal 1 GB
# Folder root ditulis berawalan "/" agar tidak ikut menangkap folder
# bernama sama di dalam data/, _ds/, atau assets/.
# =====================================================================

# ---------------------------------------------------------------------
# Dataset GIS master (±8 GB) — tidak dipakai situs.
# Seluruh isi SHP GIS/ di-ignore, termasuk dataset baru yang ditaruh
# nanti; hanya dokumen referensinya yang ikut di-commit.
# ---------------------------------------------------------------------
/SHP GIS/*
!/SHP GIS/REFERENSI-DATASET-GIS-BATAS-ADMINISTRASI.md

# Berkas GIS mentah di lokasi lain (jaring pengaman)
*.gdb/
*.shp
*.shx
*.dbf
*.cpg
*.prj
*.sbn
*.sbx
*.qix
*.qmd

# ---------------------------------------------------------------------
# Output build, berkas perantara & scratch
# ---------------------------------------------------------------------
/geo-out/
/work/
/uploads/
.thumbnail/
*.bak*
*.tmp
*.log
~$*

# ---------------------------------------------------------------------
# Lingkungan pengembangan (Python / Node)
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/.venv/
/venv/
/env/
/ENV/
.ipynb_checkpoints/
node_modules/

# ---------------------------------------------------------------------
# Rahasia & pengaturan lokal — repo ini publik dan terbit utuh
# ---------------------------------------------------------------------
.env
.env.*
.claude/settings.local.json

# ---------------------------------------------------------------------
# OS & editor
# ---------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# =====================================================================
# RUNTIME GITHUB PAGES — JANGAN DI-IGNORE
# Dimuat situs saat live. Sengaja paling bawah supaya menang atas pola
# di atasnya (mis. kelak ada "*.png" atau "*.json"). Negasi TIDAK bisa
# menyelamatkan berkas bila folder induknya di-ignore — jangan pernah
# menambah pola "data/", "_ds/", atau "assets/".
# =====================================================================
!/*.html
!/support.js
!/.nojekyll
!/assets/*.png
!/assets/*.svg
!/_ds/**/*.css
!/_ds/**/*.js
!/_ds/**/*.woff2
!/_ds/**/*.otf
!/data/geo/*.json
!/data/geo/*/*.json
!/data/idm/*/*.json
!/data/idm/*/prov/*.json
